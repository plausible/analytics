<nav class="relative z-20 py-3">
  <div class="container print:max-w-full">
    <div class="flex items-center gap-x-2">
      <%= if @current_user do %>
        <PlausibleWeb.LayoutView.breadcrumb
          conn={@conn}
          current_user={@current_user}
          current_team={@current_team}
          current_team_role={@current_team_role}
          teams={@teams}
          my_team={@my_team}
          site={@site}
          site_role={@site_role}
          nav_sites={@nav_sites}
          nav_team_meta={@nav_team_meta}
        />
      <% else %>
        <a href={PlausibleWeb.LayoutView.home_dest(@current_user)}>
          <Layout.logo />
        </a>
      <% end %>

      <%= if @current_user do %>
        <ul class="ml-auto flex shrink-0 items-center gap-x-2">
          <li :if={
            ee?() && @site &&
              Plausible.Auth.super_admin?(@current_user)
          }>
            <.styled_link
              class="text-sm font-medium !hidden"
              href={"/cs/sites/site/#{@site.id}"}
              new_tab={true}
            >
              CS
            </.styled_link>
          </li>
          <li
            :if={
              ee?() and Plausible.Teams.on_trial?(@current_team) and
                (not Plausible.Teams.setup?(@current_team) or
                   @current_team_role in Plausible.Billing.allowed_roles()) and
                @trial_badge?
            }
            class="hidden sm:block"
          >
            <div class="flex items-center gap-x-2 px-3 py-1.5 rounded-lg bg-gradient-to-r from-indigo-100 to-purple-100 dark:from-indigo-600/35 dark:to-purple-600/35 overflow-hidden">
              <span class="text-sm font-medium text-gray-900 dark:text-gray-100">
                {PlausibleWeb.LayoutView.trial_notification(@current_team)}
              </span>
              <div class="w-px h-4 bg-indigo-500/30 dark:bg-indigo-200/30" aria-hidden="true">
              </div>
              <.styled_link
                href={~p"/settings/billing/subscription"}
                class="plausible-event-name=Trial+Notification+Upgrade+Click text-sm font-medium dark:!text-indigo-400 dark:hover:!text-indigo-300"
              >
                Choose a plan
              </.styled_link>
            </div>
          </li>
          <li>
            <Layout.nav_dropdown id="nav-account" align={:right} width="w-64">
              <:trigger>
                <button
                  x-ref="button"
                  x-on:click="toggle()"
                  type="button"
                  aria-label="Account menu"
                  class="rounded-full p-0.5 hover:bg-gray-100 dark:hover:bg-gray-800"
                  x-bind:class="open && 'bg-gray-100 dark:bg-gray-800'"
                >
                  <Layout.nav_avatar user={@current_user} class="size-8 text-[13px]" />
                </button>
              </:trigger>
              <:menu>
                <div class="flex items-center gap-x-2 px-2.5 py-1.5">
                  <Layout.nav_avatar user={@current_user} class="size-9 text-sm" />
                  <div class="min-w-0">
                    <p class="truncate text-sm text-gray-900 dark:text-gray-100">
                      {@current_user.name}
                    </p>
                    <p class="truncate text-xs text-gray-500 dark:text-gray-400">
                      {@current_user.email}
                    </p>
                  </div>
                </div>

                <Layout.nav_menu_divider />

                <Layout.nav_menu_item href={~p"/settings"}>
                  <:icon>
                    <Heroicons.cog_6_tooth class={PlausibleWeb.LayoutView.nav_icon_class()} />
                  </:icon>
                  Settings
                </Layout.nav_menu_item>

                <Layout.nav_menu_divider />

                <Layout.nav_menu_item new_tab href="https://plausible.io/docs">
                  <:icon>
                    <Heroicons.question_mark_circle class={
                      PlausibleWeb.LayoutView.nav_icon_class()
                    } />
                  </:icon>
                  Help center
                </Layout.nav_menu_item>
                <Layout.nav_menu_item :if={ee?()} new_tab href="https://plausible.io/contact">
                  <:icon>
                    <Heroicons.chat_bubble_left class={PlausibleWeb.LayoutView.nav_icon_class()} />
                  </:icon>
                  Contact support
                </Layout.nav_menu_item>
                <Layout.nav_menu_item
                  :if={ee?()}
                  new_tab
                  href={PlausibleWeb.LayoutView.feedback_link(@current_user)}
                >
                  <:icon>
                    <Icons.lightbulb_icon class={PlausibleWeb.LayoutView.nav_icon_class()} />
                  </:icon>
                  Feature requests
                </Layout.nav_menu_item>
                <Layout.nav_menu_item
                  :if={ce?()}
                  new_tab
                  href="https://github.com/plausible/analytics"
                >
                  <:icon>
                    <Heroicons.code_bracket class={PlausibleWeb.LayoutView.nav_icon_class()} />
                  </:icon>
                  Github repo
                </Layout.nav_menu_item>

                <Layout.nav_menu_divider />

                <Layout.nav_menu_item href="/logout">
                  <:icon>
                    <Icons.logout_icon class={PlausibleWeb.LayoutView.nav_icon_class()} />
                  </:icon>
                  Log out
                </Layout.nav_menu_item>
              </:menu>
            </Layout.nav_dropdown>
          </li>
          <li :if={ee?()} id="changelog-notification" class="relative py-2 empty:hidden"></li>
        </ul>
      <% else %>
        <div
          class="ml-auto flex items-center gap-2"
          x-show="!document.cookie.includes('logged_in=true')"
        >
          <.button_link href="/login" theme="ghost" mt?={false}>Login</.button_link>
          <.button_link
            :if={Plausible.Auth.check_registration_enabled() == :ok}
            href="/register"
            mt?={false}
          >
            Sign up
          </.button_link>
        </div>
      <% end %>
    </div>
  </div>
</nav>
