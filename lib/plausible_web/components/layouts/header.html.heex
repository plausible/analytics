<nav class="relative z-20 py-5">
  <div class="container print:max-w-full">
    <nav class="relative flex items-center justify-between sm:h-10 md:justify-center">
      <div class="flex items-center flex-1 md:absolute md:inset-y-0 md:left-0">
        <a href={PlausibleWeb.LayoutView.home_dest(@current_user)}>
          <Layout.logo />
        </a>
      </div>
      <div class="absolute inset-y-0 right-0 flex items-center justify-end">
        <%= cond do %>
          <% @current_user -> %>
            <ul class="flex items-center gap-2 w-full sm:w-auto">
              <li :if={
                ee?() && @site &&
                  Plausible.Auth.super_admin?(@current_user)
              }>
                <.styled_link
                  class="text-sm font-medium"
                  href={"/cs/sites/site/#{@site.id}"}
                  new_tab={true}
                >
                  CS
                </.styled_link>
              </li>
              <li
                :if={
                  ee?() and Plausible.Teams.on_trial?(@current_team) and
                    (not Plausible.Teams.setup?(@current_team) or
                       @current_team_role in Plausible.Billing.allowed_roles()) and
                    @trial_badge?
                }
                class="hidden sm:block"
              >
                <div class="flex items-center gap-x-2 px-3.5 py-2 rounded-lg bg-gradient-to-r from-indigo-100 to-purple-100 dark:from-indigo-600/35 dark:to-purple-600/35 overflow-hidden">
                  <span class="text-sm font-medium text-gray-900 dark:text-gray-100">
                    {PlausibleWeb.LayoutView.trial_notification(@current_team)}
                  </span>
                  <div class="w-px h-4 bg-indigo-500/30 dark:bg-indigo-200/30" aria-hidden="true">
                  </div>
                  <.styled_link
                    href={~p"/settings/billing/subscription"}
                    class="plausible-event-name=Trial+Notification+Upgrade+Click text-sm font-medium dark:!text-indigo-400 dark:hover:!text-indigo-300"
                  >
                    Choose a plan
                  </.styled_link>
                </div>
              </li>
              <li class="w-full sm:w-auto">
                <.dropdown>
                  <:button theme="ghost" size="sm" class="pr-1.5">
                    <span class="hidden md:block text-sm font-medium truncate dark:text-gray-100">
                      {@current_user.name}
                    </span>
                    <img
                      src={Plausible.Auth.User.profile_img_url(@current_user)}
                      class="size-6 rounded-full"
                    />
                  </:button>
                  <:menu class="max-w-xs">
                    <.dropdown_item>
                      <div class="text-xs text-gray-500 dark:text-gray-400">Signed in as</div>
                      <p class="truncate font-medium text-gray-900 dark:text-gray-100" role="none">
                        {@current_user.email}
                      </p>
                    </.dropdown_item>
                    <PlausibleWeb.LayoutView.team_switcher
                      teams={@teams}
                      my_team={@my_team}
                      current_team={@current_team}
                    />
                    <.dropdown_divider />
                    <.dropdown_item href={~p"/settings"}>
                      Account settings
                    </.dropdown_item>

                    <div :if={@my_team && @my_team.id == @current_team.id}>
                      <.dropdown_item
                        class="flex"
                        href={~p"/team/setup"}
                      >
                        <span data-test="create-a-team-cta" class="flex-1">
                          Create a team
                        </span>
                      </.dropdown_item>
                      <.dropdown_divider />
                    </div>

                    <div :if={Plausible.Teams.setup?(@current_team)}>
                      <.dropdown_item
                        class="flex"
                        href={~p"/settings/team/general"}
                      >
                        <span class="flex-1">
                          Team settings
                        </span>
                      </.dropdown_item>
                      <.dropdown_divider />
                    </div>
                    <.dropdown_item
                      class="!flex justify-between gap-x-12"
                      new_tab
                      href="https://plausible.io/docs"
                    >
                      Help center
                    </.dropdown_item>
                    <.dropdown_item
                      :if={ee?()}
                      class="!flex justify-between gap-x-12"
                      new_tab
                      href="https://plausible.io/contact"
                    >
                      Contact support
                    </.dropdown_item>
                    <.dropdown_item
                      :if={ee?()}
                      class="!flex justify-between gap-x-12"
                      new_tab
                      href={PlausibleWeb.LayoutView.feedback_link(@current_user)}
                    >
                      Feature requests
                    </.dropdown_item>
                    <.dropdown_item
                      :if={ce?()}
                      class="!flex justify-between gap-x-12"
                      new_tab
                      href="https://github.com/plausible/analytics"
                    >
                      Github repo
                    </.dropdown_item>
                    <.dropdown_item href="/logout">Log out</.dropdown_item>
                  </:menu>
                </.dropdown>
              </li>
              <li :if={ee?()} id="changelog-notification" class="relative py-2 empty:hidden"></li>
            </ul>
          <% true -> %>
            <div
              class="flex items-center gap-2"
              x-show="!document.cookie.includes('logged_in=true')"
            >
              <.button_link href="/login" theme="ghost" mt?={false}>Login</.button_link>
              <.button_link
                :if={Plausible.Auth.check_registration_enabled() == :ok}
                href="/register"
                mt?={false}
              >
                Sign up
              </.button_link>
            </div>
        <% end %>
      </div>
    </nav>
  </div>
</nav>
