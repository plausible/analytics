<.settings_tiles>
  <.tile docs="mcp">
    <:title>
      <a id="connected-apps">Connected apps</a>
    </:title>
    <:subtitle>
      Applications you have authorized to access your Plausible data, such as MCP clients.
    </:subtitle>

    <div
      :if={@grant_counts.all > 0}
      class="mb-4 inline-flex rounded-md bg-gray-100 dark:bg-gray-800 p-0.5 text-xs font-medium"
    >
      <a
        :for={
          {label, count, include_revoked, href} <- [
            {"Active", @grant_counts.active, false, ~p"/settings/connected-apps"},
            {"All", @grant_counts.all, true, ~p"/settings/connected-apps?include_revoked=true"}
          ]
        }
        href={href}
        aria-current={if include_revoked == @include_revoked, do: "page"}
        class={[
          "px-3 py-1 rounded",
          if(include_revoked == @include_revoked,
            do: "bg-white dark:bg-gray-700 shadow-sm text-gray-900 dark:text-gray-100",
            else: "text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
          )
        ]}
      >
        {label} ({count})
      </a>
    </div>

    <%= if @grants.total_entries == 0 do %>
      <div class="flex flex-col items-center justify-center pt-5 pb-6 max-w-md mx-auto">
        <h3 class="text-center text-base font-medium text-gray-900 dark:text-gray-100 leading-7">
          No connected apps
        </h3>
        <p class="text-center text-sm mt-1 text-gray-500 dark:text-gray-400 leading-5 text-pretty">
          Applications you authorize to access your Plausible account will appear here.
        </p>
        <.button_link
          href="https://plausible.io/docs/mcp"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6"
        >
          Learn how to connect <PlausibleWeb.Components.Icons.external_link_icon class="size-4" />
        </.button_link>
      </div>
    <% else %>
      <.table rows={@grants.entries}>
        <:thead>
          <.th hide_on_mobile>Application</.th>
          <.th hide_on_mobile>Team</.th>
          <.th hide_on_mobile>Connected</.th>
          <.th hide_on_mobile><span class="whitespace-nowrap">Last used</span></.th>
          <.th invisible hide_on_mobile>Actions</.th>
        </:thead>

        <:tbody :let={grant}>
          <% expired? =
            NaiveDateTime.before?(grant.refresh_token_expires_at, NaiveDateTime.utc_now()) %>
          <.td max_width="max-w-0" class="w-full" title={grant.client_id}>
            <div x-data="{ open: false }">
              <div class="flex items-center gap-x-3 min-h-9" x-on:click="open = !open">
                <PlausibleWeb.Live.Sites.favicon domain={URI.parse(grant.client_id).host} />
                <div data-testid="name-cell" class="min-w-0 flex-1">
                  <div class="flex items-center gap-x-1">
                    <span class="truncate font-medium">{grant.client_name || "Unnamed app"}</span>
                    <.pill :if={grant.revoked_at} color={:red} class="shrink-0 !py-0.5 !px-1.5">
                      Revoked
                    </.pill>
                    <.pill
                      :if={expired? and is_nil(grant.revoked_at)}
                      color={:gray}
                      class="shrink-0 !py-0.5 !px-1.5"
                    >
                      Expired
                    </.pill>
                  </div>
                  <span class="block truncate text-xs text-gray-500 dark:text-gray-400">
                    {grant.client_id}
                  </span>
                </div>
                <.button
                  theme="ghost"
                  size="sm"
                  icon?={true}
                  class="md:hidden shrink-0"
                  aria-label={"Show details for #{Plausible.OAuth.Grant.label(grant)}"}
                  x-bind:aria-expanded="open"
                >
                  <Heroicons.chevron_down x-show="!open" class="size-4" />
                  <Heroicons.chevron_up x-show="open" x-cloak class="size-4" />
                </.button>
              </div>
              <div
                data-testid="mobile-details"
                x-show="open"
                x-cloak
                class="md:hidden mt-3 flex flex-col gap-3 text-xs whitespace-normal"
              >
                <dl class="grid grid-cols-[auto_1fr] gap-x-2 gap-y-1">
                  <dt class="text-gray-500 dark:text-gray-400">Team:</dt>
                  <dd class="break-words min-w-0">{Plausible.Teams.name(grant.team)}</dd>
                  <dt class="text-gray-500 dark:text-gray-400">Connected:</dt>
                  <dd>{PlausibleWeb.TextHelpers.format_date(grant.inserted_at)}</dd>
                  <dt class="text-gray-500 dark:text-gray-400">Last used:</dt>
                  <dd>
                    {PlausibleWeb.TextHelpers.humanize_last_used_with_5_minute_precision(
                      grant.last_used_at
                    )}
                  </dd>
                </dl>
                <.button
                  :if={is_nil(grant.revoked_at) and not expired?}
                  type="submit"
                  form={"revoke-grant-#{grant.id}"}
                  theme="danger"
                  size="sm"
                  class="self-start"
                  data-confirm={"Are you sure you want to revoke access for #{Plausible.OAuth.Grant.label(grant)}? The application will need to be authorized again to reconnect."}
                >
                  Revoke
                </.button>
              </div>
            </div>
          </.td>
          <.td
            hide_on_mobile
            data-testid="team-cell"
            text={Plausible.Teams.name(grant.team)}
            max_width="max-w-40"
          />
          <.td
            hide_on_mobile
            data-testid="connected-cell"
            title={Calendar.strftime(grant.inserted_at, "%Y-%m-%d %H:%M:%S UTC")}
          >
            {PlausibleWeb.TextHelpers.format_date(grant.inserted_at)}
          </.td>
          <.td hide_on_mobile data-testid="last-used-cell">
            {PlausibleWeb.TextHelpers.humanize_last_used_with_5_minute_precision(
              grant.last_used_at
            )}
          </.td>
          <.td actions hide_on_mobile>
            <.form
              :if={is_nil(grant.revoked_at) and not expired?}
              id={"revoke-grant-#{grant.id}"}
              for={%{}}
              action={~p"/settings/connected-apps/#{grant.id}"}
              method="delete"
            >
              <input
                :if={@grants.page_number > 1}
                type="hidden"
                name="page"
                value={@grants.page_number}
              />
              <input :if={@include_revoked} type="hidden" name="include_revoked" value="true" />
              <.button
                type="submit"
                theme="ghost"
                size="sm"
                icon?={true}
                class="btn-text-danger"
                aria-label={"Revoke access for #{Plausible.OAuth.Grant.label(grant)}"}
                title="Revoke access"
                data-confirm={"Are you sure you want to revoke access for #{Plausible.OAuth.Grant.label(grant)}? The application will need to be authorized again to reconnect."}
              >
                <Heroicons.x_mark class="size-4" />
              </.button>
            </.form>
          </.td>
        </:tbody>
      </.table>
    <% end %>

    <PlausibleWeb.Components.NumberedPagination.render
      :if={@grants.total_pages > 1}
      class="mt-6"
      href={
        ~p"/settings/connected-apps?#{if @include_revoked, do: [include_revoked: true], else: []}"
      }
      page_number={@grants.page_number}
      total_pages={@grants.total_pages}
    />
  </.tile>
</.settings_tiles>
