<Layouts.app
  footer?={false}
  global_notices?={false}
  current_user={@current_user}
  current_team={@current_team}
  current_team_role={@current_team_role}
  teams={@teams}
  my_team={@my_team}
  flash={@flash}
>
  <NewSiteForm.new_site_form
    changeset={@changeset}
    form_submit_url={@form_submit_url}
    site_limit_exceeded?={@site_limit_exceeded?}
    site_limit={@site_limit}
    current_user={@current_user}
    current_team={@current_team}
    secondary_action_text="Back to sites"
    secondary_action_href={~p"/sites"}
  />
</Layouts.app>
