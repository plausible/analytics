Your {Plausible.product_name()} export for {@site.domain} is now ready for download.
Please click <a href={@download_url}>here</a>
to start the download process.
<%= cond do %>
  <% @deletion_date -> %>
    Your stats for {@site.domain} are scheduled to be deleted on {date_format(@deletion_date)}, and this link stops working then, so please download your export before that date.
  <% @expires_in -> %>
    Note that this link will expire {@expires_in}.
  <% true -> %>
<% end %>
